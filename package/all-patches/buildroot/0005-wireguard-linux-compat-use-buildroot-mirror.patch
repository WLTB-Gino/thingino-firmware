wireguard-linux-compat: use buildroot mirror, not zx2c4

zx2c4 regenerated the source snapshot for 1.0.20220627 (the repo is
archived), so the historical tarball hash no longer verifies from the
primary site. sources.buildroot.net still serves the original bytes
that the hash file documents, so fetch from the mirror and keep the
hash. Diff is download-mechanics only; the package and its hash are
untouched.
---
diff --git a/package/wireguard-linux-compat/wireguard-linux-compat.mk b/package/wireguard-linux-compat/wireguard-linux-compat.mk
index 1111111111..2222222222 100644
--- a/package/wireguard-linux-compat/wireguard-linux-compat.mk
+++ b/package/wireguard-linux-compat/wireguard-linux-compat.mk
@@ -5,7 +5,11 @@
 ################################################################################

 WIREGUARD_LINUX_COMPAT_VERSION = 1.0.20220627
-WIREGUARD_LINUX_COMPAT_SITE = https://git.zx2c4.com/wireguard-linux-compat/snapshot
+# git.zx2c4.com regenerated its snapshots (repo archived), breaking the
+# historical hash; the buildroot mirror serves the original tarball.
+WIREGUARD_LINUX_COMPAT_SITE = https://sources.buildroot.net/wireguard-linux-compat
 WIREGUARD_LINUX_COMPAT_SOURCE = wireguard-linux-compat-$(WIREGUARD_LINUX_COMPAT_VERSION).tar.xz

 $(eval $(generic-package))
--
2.39.5

